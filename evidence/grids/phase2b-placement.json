{
  "base": {
    "device.topology": "ocp",
    "kv.model": "llama-3.1-8b",
    "ext.system.gpu": "b200",
    "kv.layout": "striped_contiguous",
    "placement.check_writes": true
  },
  "vary": {
    "placement.batch": [8, 32],
    "kv.context": [4096, 32768],
    "placement.generated": [0, 338, 2048]
  },
  "zip": [
    {"placement.alloc": "layer_major"},
    {"placement.alloc": "dedicated"},
    {"placement.alloc": "packed"},
    {"placement.alloc": "packed", "placement.flush_order": "layer"},
    {"placement.alloc": "dedicated", "placement.partition": "channel"},
    {"placement.alloc": "packed", "placement.partition": "die"},
    {"placement.alloc": "vllm_pool"},
    {"placement.alloc": "vllm_pool", "placement.free_order": "shuffled:7"}
  ]
}
