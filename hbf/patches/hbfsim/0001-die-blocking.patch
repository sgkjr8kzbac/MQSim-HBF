+void HbfController::record_die_window(
+    std::vector<PlaneState::BusyWindow>& windows,
+    double begin_ns,
+    double end_ns) {
+    if (end_ns <= begin_ns) {
+        return;
+    }
+    {
+        const auto dead_end = std::upper_bound(
+            windows.begin(),
+            windows.end(),
+            reservation_causal_watermark_ns_,
+            [](double watermark, const PlaneState::BusyWindow& window) {
+                return watermark < window.end_ns;
+            });
+        const auto dead = static_cast<std::size_t>(dead_end - windows.begin());
+        if (dead >= 64 && dead * 2 >= windows.size()) {
+            windows.erase(windows.begin(), dead_end);
+        }
+    }
+    auto it = std::lower_bound(
+        windows.begin(),
+        windows.end(),
+        begin_ns,
+        [](const PlaneState::BusyWindow& window, double begin) {
+            return window.end_ns < begin;
+        });
+    if (it == windows.end() || end_ns < it->begin_ns) {
+        windows.insert(it, PlaneState::BusyWindow{
+            .begin_ns = begin_ns,
+            .end_ns = end_ns,
+        });
+        return;
+    }
+    it->begin_ns = std::min(it->begin_ns, begin_ns);
+    it->end_ns = std::max(it->end_ns, end_ns);
+    auto next = std::next(it);
+    while (next != windows.end() && next->begin_ns <= it->end_ns) {
+        it->end_ns = std::max(it->end_ns, next->end_ns);
+        ++next;
+    }
+    windows.erase(std::next(it), next);
+}
+
+double HbfController::preview_die_read_clear(
+    const DieState& die,
+    double earliest_ns,
+    double duration_ns) const {
+    double candidate = earliest_ns;
+    const auto& windows = die.die_read_windows;
+    auto it = std::lower_bound(
+        windows.begin(),
+        windows.end(),
+        candidate,
+        [](const PlaneState::BusyWindow& window, double start) {
+            return window.end_ns <= start;
+        });
+    while (it != windows.end() && it->begin_ns < candidate + duration_ns) {
+        candidate = std::max(candidate, it->end_ns);
+        ++it;
+    }
+    return candidate;
+}
