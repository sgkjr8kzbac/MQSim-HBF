+//HBF T-CMD: newly received transactions wait this long before they are dispatched, so that the
+//transactions of one batch that reach a die within the window leave in one multi-plane command.
+static sim_time_type hbf_coalesce_ns()
+{
+    static const sim_time_type window = [] {
