+sim_time_type TSU_Priority_OutOfOrder::hbf_earliest_ready(Flash_Transaction_Queue &queue)
+{
+    sim_time_type best = INVALID_TIME;
+    for (Flash_Transaction_Queue::iterator it = queue.begin(); it != queue.end(); it++)
+    {
+        if (transaction_is_ready(*it) && (*it)->Issue_time < best)
+        {
+            best = (*it)->Issue_time;
+        }
+    }
