 namespace SSD_Components
 {
+	//HBF T-PLANE: rule for the transactions that may join one multi-plane command.
+	//Unset keeps upstream (same page index, any block); "independent" accepts any address on each
+	//plane, as the OCP HBF spec allows per-bank reads; "lockstep" requires the same block and page.
+	static int hbf_plane_rule()
+	{
+		static const int rule = [] {
+			const char* value = std::getenv("HBF_T_PLANE");
+			if (value == NULL) return 0;
+			if (std::strcmp(value, "independent") == 0) return 1;
+			if (std::strcmp(value, "lockstep") == 0) return 2;
+			std::cerr << "ERROR:HBF_T_PLANE must be independent or lockstep" << std::endl;
+			exit(1);
+		}();
+		return rule;
+	}
+
+	static bool hbf_joins_command(const NVM_Transaction_Flash* tr, flash_block_ID_type blockID, flash_page_ID_type pageID)
+	{
+		switch (hbf_plane_rule()) {
+			case 1: return true;
+			case 2: return tr->Address.PageID == pageID && tr->Address.BlockID == blockID;
+			default: return tr->Address.PageID == pageID;
+		}
+	}
+
