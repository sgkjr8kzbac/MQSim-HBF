index 114b4c2..54b8654 100644
--- a/src/ssd/ONFI_Channel_NVDDR2.cpp
+++ b/src/ssd/ONFI_Channel_NVDDR2.cpp
@@ -35,5 +35,13 @@ namespace SSD_Components
 		EraseCommandTime[3] = t_CS + t_WC * 4 + t_WB + (t_DBSY + t_WC * 4 + t_WB) + (t_DBSY + t_WC * 4 + t_WB);
 		EraseCommandTime[4] = t_CS + t_WC * 4 + t_WB + (t_DBSY + t_WC * 4 + t_WB) + (t_DBSY + t_WC * 4 + t_WB) + (t_DBSY + t_WC * 4 + t_WB);
 		EraseSuspendCommandTime = t_CS + t_WC * 3;
+
+		//HBF T-PLANE: upstream fills the tables for 1-4 planes only, so a multi-plane command with
+		//more planes read past the arrays. Extend each table with the same per-plane increment.
+		for (int planes = 5; planes <= 64; planes++) {
+			ReadCommandTime[planes] = ReadCommandTime[planes - 1] + t_DBSY + 6 * t_WC;
+			ProgramCommandTime[planes] = ProgramCommandTime[planes - 1] + (t_WC * 5 + t_ADL + t_WPST + t_CALS + t_WB) + t_DBSY;
+			EraseCommandTime[planes] = EraseCommandTime[planes - 1] + (t_DBSY + t_WC * 4 + t_WB);
+		}
 	}
 }
