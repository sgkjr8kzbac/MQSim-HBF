+	static void hbf_lpa_to_static_address(const AddressMappingDomain* domain, LPA_type lpa,
+		unsigned int pages_no_per_block, NVM::FlashMemory::Physical_Page_Address& addr)
+	{
+		uint64_t ch_no = domain->Channel_no;
+		uint64_t w_no = domain->Chip_no;
+		uint64_t d_no = domain->Die_no;
+		uint64_t p_no = domain->Plane_no;
+		uint64_t units = ch_no * w_no * d_no * p_no;
+		addr.ChannelID = domain->Channel_ids[(unsigned int)(lpa % ch_no)];
+		addr.ChipID = domain->Chip_ids[(unsigned int)((lpa / ch_no) % w_no)];
+		addr.DieID = domain->Die_ids[(unsigned int)((lpa / (ch_no * w_no)) % d_no)];
+		addr.PlaneID = domain->Plane_ids[(unsigned int)((lpa / (ch_no * w_no * d_no)) % p_no)];
+		uint64_t offset = (uint64_t)lpa / units;
+		addr.BlockID = (flash_block_ID_type)(offset / pages_no_per_block);
+		addr.PageID = (flash_page_ID_type)(offset % pages_no_per_block);
+	}
