+	static void hbf_physical_event(const char* event, int command, const NVM_Transaction_Flash* tr)
+	{
+		const char* path = std::getenv("HBF_I2");
+		if (!path || !*path) return;
+		static std::ofstream log(path);
+		if (!log) throw std::runtime_error("Cannot write HBF_I2");
+		const auto& a = tr->Address;
+		log << Simulator->Time() << ',' << event << ',' << command << ','
+			<< +a.ChannelID << ',' << +a.ChipID << ',' << +a.DieID << ','
+			<< +a.PlaneID << ',' << a.BlockID << ',' << a.PageID << ',' << tr->LPA << '\n';
+	}
