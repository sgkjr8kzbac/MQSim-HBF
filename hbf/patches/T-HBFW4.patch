 	void Flash_Block_Manager_Base::Read_transaction_serviced(const NVM::FlashMemory::Physical_Page_Address& page_address)
 	{
 		PlaneBookKeepingType *plane_record = &plane_manager[page_address.ChannelID][page_address.ChipID][page_address.DieID][page_address.PlaneID];
 		plane_record->Blocks[page_address.BlockID].Ongoing_user_read_count--;
+		plane_record->Blocks[page_address.BlockID].Hbf_read_count++;
+	}
+
+	void Flash_Block_Manager_Base::Hbf_erase_transaction_serviced(const NVM::FlashMemory::Physical_Page_Address& block_address)
+	{
+		PlaneBookKeepingType *plane_record = &plane_manager[block_address.ChannelID][block_address.ChipID][block_address.DieID][block_address.PlaneID];
+		plane_record->Blocks[block_address.BlockID].Hbf_erase_count++;
+	}
+
+	void Flash_Block_Manager_Base::Hbf_dump_block_counts() const
+	{
+		const char* path = std::getenv("HBF_T_HBFW4");
+		if (!path || !*path) return;
+		std::ofstream out(path);
+		if (!out) throw std::runtime_error("Cannot write HBF_T_HBFW4");
+		out << "channel,chip,die,plane,block,reads,programs,erases\n";
+		for (unsigned int ch = 0; ch < channel_count; ch++) {
+			for (unsigned int w = 0; w < chip_no_per_channel; w++) {
+				for (unsigned int d = 0; d < die_no_per_chip; d++) {
+					for (unsigned int p = 0; p < plane_no_per_die; p++) {
+						for (unsigned int b = 0; b < block_no_per_plane; b++) {
+							const Block_Pool_Slot_Type& blk = plane_manager[ch][w][d][p].Blocks[b];
+							if (blk.Hbf_read_count || blk.Hbf_program_count || blk.Hbf_erase_count) {
+								out << ch << ',' << w << ',' << d << ',' << p << ',' << b << ','
+									<< blk.Hbf_read_count << ',' << blk.Hbf_program_count << ',' << blk.Hbf_erase_count << '\n';
+							}
+						}
+					}
+				}
+			}
+		}
 	}
 	
